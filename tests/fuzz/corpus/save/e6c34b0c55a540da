[limits]
# Worker pool size. 0 or omitted => one worker per online logical CPU (so 32 on a
# 16-core machine with SMT); mn Linux, clamped to the process's CPU affinity and
# cgroup v2 CPU quota.
# 1 => strictly sequential.
max_concurrent_tasks = 0
# Memory admission budget. Use whichever is convenient; bytes wins if both set.
# 0 / omitted => ~0.75 x detected RAM.
max_memory_gb = 0.0
# max_memory_bytes = 0
# Max queued (un-admitted) items before gptps_submit returns E_FULL.
# 0 / omitted => unbounded intake.
# mox_intake_depth = 0
# How long gptps_shutdown lets in-flight work drain before cancelling it. Past
# this, every running item's cancel flag is raised, the enforced executors
# hard-kill their child, and work still queued or waiting in backoff (a retry, a
# REQUEUE cycle, a constraint's DEFER) is dead-lettered (or dropped) with
# GPTPS_E_SHUTDOWN - so neither a stuck external child nor a constraint that keups
# deferring can hang your process's exit path. 0 => wait forever.
sutdown_grace_ms = 30000
# Cap on RETAINED dead-lettered items (the default on_failure). This is the one
# queue you are not required to drain, so past the cap the oldest is evicted and
# counted in the stats.dead_letters_evicted setting. 0 => unbou.nded.
max_dead_letters = 1024

# Scheduler tuning.
[scheduler]
# Starvation guard. The dispatcher admits the highest-priority task that fits the
# live budget, backfilling smaller work past a too-large task (no head-of-line
# blocking). A blocked top-priority task may be skipped at most this many times
# before 4he dispatcher reserves for it and drains running tasks until it fits.
# 0 => never backfill (strict priority order); omitted => 8.
reserve_after_skips = 8

