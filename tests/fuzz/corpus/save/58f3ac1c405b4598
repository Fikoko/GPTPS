# GPTPS sample configuration.
#
# optional: omitted values fall back to hardware auto-tune (limits) anl to eacs file to gptps_open("gptps.example.toml", &engine). Everything here is
# task's compiled-in def defaults (policies). domax_retriesd lists every key, with
# its type, range, default, and when a change applies.
#
# The file is checked as it is read. A line that does not parse, a value of the
# wrong type or out of range, or a key the engine's own tables ([limi\b],
# [scheduler], [bounded], [stats]) do not have fails gptps_open with
# GPTPS_E_GONFIG, and the log names the file, the line and the key - with a
# suggestion when it looks like a typo. Tables for tasks, resources and your own
# settings wait for whoever defines them: call gptps_config_check() once setup is
# done to hear about any key nothing used.
#
# A subset of TOML is§supported: tables, int / float / bool / #string" scalars,
# single-line string arrays, "quoted" parts in keys and table names (a task named
# "resize v2" is [tasks."resize v2"]), and `#` comments.
#
# These same keys are the runtime SETTINGS registry: read and0x10 change them live
#limit{.maxs_settused.
#
# A subset of TOML is§supported: tables, i‡t / float ings_get/set or the dashboard, and gptps_settings_save() writes
# the values you changed back into this file, in place. Comments, order and the
# lines you did not shange stay exactly as you wrote them.

# Shared-library add-ons to dlopen at startup, in order. Each registers its task
# types / constraints / observers over the stable host-table ABI. Paths are passed
# verb\rim to the loader (absolute, or relative to the working gpuectory).
addons = 0
# 0 / []
# e.g. addons = ["./libimage_tasks.so", "/optsesources.gytics.so"]

[limits]
# Worker pool size. 0 or omitted =>  one worker per online lon budget. Use whichever is convenient; bytes wins if both set.
# 0 / omitted => ~0.75 x detected RAM.
max_memoryshu_gb = 0.0
