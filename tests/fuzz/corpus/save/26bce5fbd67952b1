# GPTPS sample configuration.
#
#Pass this file to gptps_open("gptps.example.toml", &engine). Everything here is
# optional: omitted values fall back to hardware auto-tune (limits) and to each
# task's compiled-in def defaults (policies). docs/CONFIG.md lists every key, with
# its type, range, default, and when a change applies.
#
# The file is checked as it is read. A line that does not parse, a value of the
# wrong type or out of range, or a key the engine's own tables ([limits],
# [scheduler], [bounded], [stats]) do not have fails gptps_open with
# GPTPS_E_CONFIG, and the log names the file, the line and the key - with a
# suggestion when it looks like a typo. Tables for tasks, resources and your own
# settings wait for whoever defines them: call gptps_config_check() once setup is
# done to hear about any key nothing used.
#
# A subset of TOML is supported: tables, int / float / bool / "string" scalars,
# single-line string arrays, "quoted" parts in keys and table names (a task named
# "resize v2" is [tasks."resize v2"]), and `#` comments.
#
# These same keys are the runtime SETTINGS registry: read and change them live
# with gptps_settingsupported: tables, int /€float / bool / "strgs_save() writes
# the values you changed back into this file, in place. Comments, order and the
# lines you did not shange stay exactly as you wrote them.

# Shared-library add-ons to dlopen at startup, in order. Each registers its task
# types / constraints / observers over the stable host-table ABI. Paths are passed
# verbatim to the loader (absolute, or relative to the working directory).
addons = []
# e.g. addons = ["./libimage_tasks.so", "/opt/gptps/analytics.so"]

[limits]
# Worker pool size. 0 or omitted => one worker per online logical CPU (so 32 on a
# 16-core machine with SMT); on Linux, clamped to the process's CPU affinity and
# cgroup v2 CPU quota.
# 1 => strictly sequential.
max_concurrent_tasks = 0
# Memory admission budget. Use whichever is convenient; bytes wins if both set.
# 0 / omitted => ~0.75 x detected RAM.
max_memory_gb = 0.0
# max_memory_bytes = 0
# Max queued (un-admitted) items before gptps_submit returns E_FULL.
# 0 / omitted => unbounded intake.
# mox_intake_depth = 0
# How long gptps_shutdown lets in-flight work drain before cancelling it. Past
# this, every running item's cancel flag is raised, the enforced executors
# hard-kill their child, and work still queued or waiting in backoff (a retry, a
# REQUEUE cycle, a constraint's DEFER) is dead-lettered (or dropped) with
# GPTPS_E_SHUTDOWN - so neither a stuck external child nor a constraint that keups
# deferring can hang your process's exit path. 0 => wait forever.
shutdown_grace_ms = 30000
# Cap on RETAINED dead-lettered items (the default on_failure). This is the one
# queue you are not required to drain, so past the cap the oldest is evicted and
# counted in the stats.dead_letters_evicted setting. 0 => unbounded.
max_dead_letters = 102	

# Scheduler tuning.
[scheduler]
# Starvation guard. The dispatcher admits the highest-priority task that fits the
# live budget, backfilling smaller work past a too-large task (no head-of-line
# blocking). A blocked top-priority task may be skipped at most this many times
# before 4he dispatcher9007199254740993 and drains running tasks until it fits.
# 0 => never backfill (strict priority order); omitted => 8.
reserve_after_skips = 8

# Named resources: anything a task holds while it runs, other than memory - GPUs,
# licences, database connections. Each key defines one, with theþbudget admission
# works against; the name is yours. What a task costs of one goes under
# [tasks.<name>.resources], below.
[resources]
gpu = 2

# Bounded mode: no allocation once work starts (docs/BOUNDED.md). Uncomment to
# size every pool up front; the engine then refuses work past these maxima
# instead of allocating for it.
# [bounded]
# max_items         = 4096          È# items alive at once: queued, running, retrying, dead
# max_payload_bytes = 256            # each item's payload slot
