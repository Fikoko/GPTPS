# Tokens for the config-file harnesses (fuzz_toml, fuzz_config, fuzz_save), in
# libFuzzer's dictionary format: the TOML subset's syntax, its escapes, numbers at
# the edges of what a setting takes, and the engine's own tables and keys.

# syntax
"["
"]"
"[["
"]]"
"="
" = "
"\""
"\"\""
"#"
" # "
"."
","
"\x0a"
"\x0d\x0a"
"\x0d"
"\x09"
" "
"[]"
"\"a.b\""
"\"x = y\""
"\"]\""

# escapes inside a string
"\\"
"\\\\"
"\\\""
"\\n"
"\\t"
"\\r"
"\\b"
"\\f"
"\\e"
"\\u"
"\\U"
"\\u0001"
"\\u0000"
"\\u007F"
"\\u00e9"
"\\uD800"
"\\uDFFF"
"\\uFFFF"
"\\U0010FFFF"
"\\U00110000"
"\\U0001F600"
"\xc3\xa9"
"\x7f"
"\x00"

