# =====================
# Build output
# =====================
build/
build-*/
cmake-build-*/
out/
dist/
amalgamation/

# In-source CMake artifacts (shouldn't happen; we build out-of-tree)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile

# Compiled objects / libraries / binaries
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# Generated runtime state
analytics.json
session_config.json
deadletter.json
*.log
logs/

# Generated protobuf (nanopb) sources land in the build tree, but guard anyway
*.pb.c
*.pb.h

# Fuzzing (CONTRIBUTING.md): what a run finds, what it saves when an input fails,
# and a harness's scratch files when no GPTPS_FUZZ_TMPDIR is set
/work/
/merged/
crash-*
leak-*
timeout-*
gptps_fz_*

# =====================
# Editors / OS
# =====================
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*.bak
compile_commands.json

# =====================
# AI tooling
# =====================
# Assistant scratch/config, if a contributor uses one. Not required to build.
.claude/
