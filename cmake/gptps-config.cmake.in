@PACKAGE_INIT@

# GPTPS links the platform thread library; re-find it for consumers.
include(CMakeFindDependencyMacro)
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/gptps-targets.cmake")

# Which add-ons THIS install actually contains, baked in at configure time. An
# install built with -DGPTPS_ADDONS=none exports no add-on targets at all, and one
# built on Windows never has `xport` (it needs fork + socketpair). A consumer asking
# for a missing one deserves a sentence that says so - not a cryptic "target
# gptps::xport not found" from their first target_link_libraries, three files later.
set(GPTPS_ADDONS "@GPTPS_BUILT_ADDONS@")

foreach(_comp IN LISTS gptps_FIND_COMPONENTS)
    # list(FIND) rather than IN_LIST, so this file carries no CMP0057 dependency.
    list(FIND GPTPS_ADDONS "${_comp}" _idx)
    if(_idx EQUAL -1)
        set(gptps_${_comp}_FOUND FALSE)
        if(NOT DEFINED gptps_NOT_FOUND_MESSAGE)
            set(gptps_NOT_FOUND_MESSAGE
                "this GPTPS install has no '${_comp}' add-on (it has: ${GPTPS_ADDONS}). \
Rebuild GPTPS with -DGPTPS_ADDONS=all, or see docs/PACKAGING.md.")
        endif()
    else()
        set(gptps_${_comp}_FOUND TRUE)
    endif()
    unset(_idx)
endforeach()

check_required_components(gptps)
